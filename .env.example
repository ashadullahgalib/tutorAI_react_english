# ─── REQUIRED ──────────────────────────────────────────────────────────────
# Secret key for the API (choose any long random string)
API_SECRET_KEY=change-me-to-a-long-random-string

# ─── OLLAMA ─────────────────────────────────────────────────────────────────
# Make sure Ollama is installed and running: https://ollama.com
# Pull the models before starting:
#   ollama pull qwen2.5:7b
#   ollama pull llava:7b        (needed only for image/photo uploads)

# ─── OPTIONAL ───────────────────────────────────────────────────────────────
# Path to the directory that contains the "books/" folder.
# If unset, the app auto-detects (looks next to this .env file).
# COACHING_DATA_DIR=/home/user/tutor_ai

LOG_LEVEL=INFO

# Redis session store URL (leave blank for in-memory sessions)
REDIS_URL=

# Frontend API URL (only needed if frontend runs on a different machine)
COACHING_API_URL=http://localhost:8000
